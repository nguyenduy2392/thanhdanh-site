{
  "name": "thanhdanh-site",
  "private": true,
  "version": "2.0.0",
  "description": "Thanh Danh Soft company site (thanhdanh.pro.vn), static, EN/VI",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "assets": "python3 tools/make_assets.py",
    "qa": "node build.mjs && python3 tools/qa.py",
    "preview": "node build.mjs && python3 -m http.server 8098 --directory dist",
    "dev": "node build.mjs && wrangler dev",
    "deploy": "node build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.100.0"
  }
}
